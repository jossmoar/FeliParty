# Copiá este archivo como ".env" y llená los valores reales que te da la
# consola de Firebase (Configuración del proyecto > Tus apps > SDK setup).
# En Vercel, estas mismas variables van en Settings > Environment Variables.
#
# IMPORTANTE: .env está en .gitignore y NUNCA debe subirse a GitHub.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dirección pública del sitio en Vercel. El QR apunta aquí.
# Cambiala si Vercel te asigna otro dominio y corré: npm run qr
SITE_URL=https://feliparty.vercel.app
